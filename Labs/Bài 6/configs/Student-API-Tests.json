{
	"info": {
		"_postman_id": "devops-lab6-student-api",
		"name": "Student API Tests",
		"description": "Postman collection for DevOps Lab 6 — API Functional Testing",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "GET All Students",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has success field', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.true;",
							"});",
							"",
							"pm.test('Data is an array', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data).to.be.an('array');",
							"});",
							"",
							"pm.test('Has at least 3 students', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.length).to.be.at.least(3);",
							"});",
							"",
							"pm.test('Response time < 200ms', function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:3000/api/students",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["api", "students"]
				}
			}
		},
		{
			"name": "GET Student by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', () => {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Returns correct student', () => {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.name).to.equal('Nguyen Van A');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:3000/api/students/SV001",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["api", "students", "SV001"]
				}
			}
		},
		{
			"name": "POST Create Student",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', () => {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Returns created student', () => {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.name).to.equal('Pham Thi D');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\"id\": \"SV004\", \"name\": \"Pham Thi D\", \"age\": 22, \"grade\": \"K19\"}"
				},
				"url": {
					"raw": "http://localhost:3000/api/students",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["api", "students"]
				}
			}
		},
		{
			"name": "GET Student Not Found (404)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 404', () => {",
							"    pm.response.to.have.status(404);",
							"});",
							"",
							"pm.test('Returns error message', () => {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.false;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:3000/api/students/SV999",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["api", "students", "SV999"]
				}
			}
		},
		{
			"name": "POST Missing Fields (Validation)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 400', () => {",
							"    pm.response.to.have.status(400);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\"name\": \"Test\"}"
				},
				"url": {
					"raw": "http://localhost:3000/api/students",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["api", "students"]
				}
			}
		}
	]
}
